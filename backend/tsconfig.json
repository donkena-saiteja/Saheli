{
  "compilerOptions": {
    "target": "ES2022",
    // node16 keeps CommonJS emit (package.json has no "type": "module") while
    // enabling package.json "exports" subpath resolution, which @x402/* needs.
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
