# App Environment Variables Example
# Copy to .env (or .env.production) before building.

# Where the API lives.
#   '/api'                              — frontend and backend behind the same
#                                         host, or Vite's dev proxy (default)
#   'https://your-api.onrender.com/api' — separate hosts (Vercel/Netlify + Render)
VITE_API_BASE_URL=/api

# Algorand network Pera Wallet connects to: testnet | mainnet | betanet.
# Must match the backend's ALGORAND_NETWORK, or wallet sign-in targets the
# wrong chain.
VITE_ALGORAND_NETWORK=testnet
