# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
# Optional: absolute path to built frontend dist for single-server deploys
FRONTEND_DIST_PATH=../app/dist

# MongoDB
# If this is unreachable the API automatically falls back to an in-process
# MongoDB, so the stack runs with no external services installed.
MONGODB_URI=mongodb://127.0.0.1:27017/saheli
# Set false to require a real MongoDB and disable the in-process fallback.
USE_MEMORY_DB=true

# ─────────────────────────────────────────────────────────────────────────────
# ALGORAND
# ─────────────────────────────────────────────────────────────────────────────
# testnet | mainnet | localnet
ALGORAND_NETWORK=testnet
# Defaults to the public AlgoNode endpoints, which need no API token.
ALGOD_SERVER=https://testnet-api.algonode.cloud
INDEXER_SERVER=https://testnet-idx.algonode.cloud
ALGOD_TOKEN=
INDEXER_TOKEN=

# 25-word mnemonic for the relayer/treasury account. Leave blank to use the
# deterministic derived account printed at /api/algorand/info, then fund that
# address at https://bank.testnet.algorand.network to enable live settlement.
ALGORAND_RELAYER_MNEMONIC=
# Seed for deriving member wallets. Change this for a real deployment.
ALGORAND_MASTER_SEED=
# SHG-Rupee ASA id. 0 anchors ledger entries via transaction notes instead.
SHG_ASA_ID=0
SHG_TREASURY_ADDRESS=
# Force simulated settlement even when the relayer is funded.
ALGORAND_FORCE_SIMULATION=false

# Deployed AlgoKit contract ids (see contracts/README.md)
SHG_TREASURY_APP_ID=
X402_GATEWAY_APP_ID=
DSBT_REGISTRY_APP_ID=

# ─────────────────────────────────────────────────────────────────────────────
# x402 PAY-PER-USE  (mandatory hackathon requirement)
# ─────────────────────────────────────────────────────────────────────────────
# Settlement asset. Defaults to USDC on the active network
# (TestNet 10458941 / MainNet 31566704).
X402_SETTLEMENT_ASA_ID=
# Address receiving x402 revenue. Defaults to the SHG treasury.
X402_PAY_TO=
# Leave blank to use the built-in local facilitator (no external dependency).
# Set to https://facilitator.goplausible.xyz to settle via the public one.
X402_FACILITATOR_URL=
X402_FACILITATOR_TIMEOUT_MS=8000

# ─────────────────────────────────────────────────────────────────────────────
# WHATSAPP BANKING
# ─────────────────────────────────────────────────────────────────────────────
# 4-digit MPIN for seeded demo accounts.
WHATSAPP_DEMO_MPIN=1234
# Session idle timeout before re-authentication is required.
WHATSAPP_SESSION_TIMEOUT_MS=600000

# ─────────────────────────────────────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────────────────────────────────────
# JWT Secret. CHANGE THIS before deploying — the fallback is public knowledge.
JWT_SECRET=your-jwt-secret-here

# Pera Wallet sign-in: how long a signing challenge stays valid (ms).
WALLET_CHALLENGE_TTL_MS=300000

# OpenAI (optional — for live AI responses)
OPENAI_API_KEY=sk-your-key-here
# Optional OpenAI chat model for free-form WhatsApp queries
OPENAI_CHAT_MODEL=gpt-4o-mini

# Sarvam AI Translation (for website localization)
SARVAM_API_KEY=your-sarvam-api-key
# Optional; keep default unless your Sarvam endpoint is different
SARVAM_API_URL=https://api.sarvam.ai/translate
# Optional; set to authorization if your key must be sent as Bearer token
SARVAM_API_KEY_HEADER=api-subscription-key
# Optional application identifier for Sarvam headers
SARVAM_APP_ID=

# Twilio WhatsApp (optional)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Preferred key (falls back to TWILIO_WHATSAPP_NUMBER)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional: use Messaging Service instead of explicit From
TWILIO_MESSAGING_SERVICE_SID=
# Validate incoming Twilio signatures (recommended true in production)
TWILIO_VALIDATE_SIGNATURE=true
# Public HTTPS base URL used to validate webhook signatures, e.g. https://abc123.ngrok.io
PUBLIC_BASE_URL=
# Optional explicit status callback URL (defaults to PUBLIC_BASE_URL + /webhook/twilio/status)
TWILIO_STATUS_CALLBACK_URL=
# Optional WhatsApp approved template sid (for business-initiated messages)
TWILIO_WHATSAPP_CONTENT_SID=

# QR Code Storage (optional — uses base64 by default)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional unsigned upload preset (if set, API key/secret are not required for upload)
CLOUDINARY_UPLOAD_PRESET=your-upload-preset
# Optional upload folder
CLOUDINARY_FOLDER=saheli/qr-proofs
