{
  "name": "saheli-backend",
  "version": "1.0.0",
  "description": "Saheli SHG Chain - Full Stack Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "verify": "ts-node --transpile-only src/scripts/verify.ts",
    "seed": "ts-node --transpile-only src/scripts/seed-atlas.ts",
    "verify:x402": "node scripts/verify-x402-loan-gate.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@x402/avm": "^2.20.0",
    "@x402/core": "^2.20.0",
    "@x402/express": "^2.20.0",
    "algosdk": "^3.6.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.1",
    "qrcode": "^1.5.3",
    "tweetnacl": "^1.0.3",
    "twilio": "^5.13.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.8",
    "mongodb-memory-server": "^10.4.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
